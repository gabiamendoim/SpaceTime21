<script>
const ENTRY_KEY="spacetimeDiarioEntradas",MOOD_KEY="spacetimeHumoresPersonalizados",ACTIVITY_KEY="spacetimeAtividades",REMOVED_ACTIVITY_KEY="spacetimeAtividadesRemovidas",THEME_KEY="spacetimeTema",COLOR_KEY="spacetimeCor",EMAIL_KEY="spacetimeEmail";
const DEFAULT_ACTIVITIES=["Estudar","Exercícios","Jogar","Família","Amigos","Descansar"];
const MOODS=[{name:"Muito feliz",emoji:"😄"},{name:"Feliz",emoji:"🙂"},{name:"Neutro",emoji:"😐"},{name:"Triste",emoji:"🙁"},{name:"Muito triste",emoji:"😢"}];
let selectedMood=null,photoData="",selectedDate=getToday(),calendarDate=new Date(),editingMoodIndex=null;
const $=id=>document.getElementById(id);
function getToday(){const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`}
function formatDate(v){const[y,m,d]=v.split("-");return `${d}/${m}/${y}`}
function escapeHTML(v){return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]))}
function getEntries(){try{return JSON.parse(localStorage.getItem(ENTRY_KEY))||[]}catch{return[]}}
function saveEntries(e){localStorage.setItem(ENTRY_KEY,JSON.stringify(e))}
function getCustomMoods(){try{return JSON.parse(localStorage.getItem(MOOD_KEY))||[]}catch{return[]}}
function saveCustomMoods(m){localStorage.setItem(MOOD_KEY,JSON.stringify(m))}

function loadUserEmail(){
  const email=localStorage.getItem(EMAIL_KEY)||"";
  $("userEmail").value=email;
  $("emailStatus").textContent=email
    ? "E-mail salvo neste navegador."
    : "Seu e-mail fica salvo neste navegador para identificar seus dados.";
}
$("userEmail").addEventListener("change",()=>{
  const email=$("userEmail").value.trim();
  if(email && $("userEmail").checkValidity()){
    localStorage.setItem(EMAIL_KEY,email);
    $("emailStatus").textContent="E-mail salvo neste navegador.";
  }else if(!email){
    localStorage.removeItem(EMAIL_KEY);
    $("emailStatus").textContent="Seu e-mail fica salvo neste navegador para identificar seus dados.";
  }
});

function applyColor(color){
  if(!["blue","wine","green"].includes(color))color="blue";
  document.body.classList.remove("theme-wine","theme-green");
  if(color!=="blue")document.body.classList.add("theme-"+color);
  document.querySelectorAll(".color-button").forEach(b=>b.classList.toggle("active",b.dataset.color===color));
  localStorage.setItem(COLOR_KEY,color);
}
function loadTheme(){
  if(localStorage.getItem(THEME_KEY)==="space")document.body.classList.add("space-theme");
  applyColor(["blue","wine","green"].includes(localStorage.getItem(COLOR_KEY))?localStorage.getItem(COLOR_KEY):"blue");
}
$("themeToggle").addEventListener("click",()=>{
  const s=document.body.classList.toggle("space-theme");
  localStorage.setItem(THEME_KEY,s?"space":"day");
});
document.querySelectorAll(".color-button").forEach(b=>{
  b.addEventListener("click",()=>applyColor(b.dataset.color));
});

function getCustomActivities(){try{return JSON.parse(localStorage.getItem(ACTIVITY_KEY))||[]}catch{return[]}}
function saveCustomActivities(a){localStorage.setItem(ACTIVITY_KEY,JSON.stringify(a))}
function getRemovedActivities(){try{return JSON.parse(localStorage.getItem(REMOVED_ACTIVITY_KEY))||[]}catch{return[]}}
function saveRemovedActivities(a){localStorage.setItem(REMOVED_ACTIVITY_KEY,JSON.stringify(a))}
function getAllActivities(){const r=getRemovedActivities(),c=getCustomActivities();return [...DEFAULT_ACTIVITIES,...c].filter((a,i,arr)=>arr.indexOf(a)===i&&!r.includes(a))}
function renderActivities(){const c=$("activities");c.innerHTML="";getAllActivities().forEach(a=>{const l=document.createElement("label");l.className="activity";l.innerHTML=`<input type="checkbox" value="${escapeHTML(a)}"><span class="activity-name">${escapeHTML(a)}</span><button type="button" class="activity-delete" aria-label="Excluir atividade ${escapeHTML(a)}" title="Excluir atividade">×</button>`;l.querySelector(".activity-delete").addEventListener("click",e=>{e.preventDefault();e.stopPropagation();deleteActivity(a)});c.appendChild(l)})}
function deleteActivity(a){if(!confirm(`Excluir a atividade "${a}"?`))return;const r=getRemovedActivities();if(!r.includes(a))r.push(a);saveRemovedActivities(r);saveCustomActivities(getCustomActivities().filter(x=>x!==a));renderActivities()}
$("addActivity").addEventListener("click",()=>{$("newActivity").value="";$("activityModal").classList.add("active");setTimeout(()=>$("newActivity").focus(),50)});
$("confirmActivity").addEventListener("click",()=>{const n=$("newActivity").value.trim();if(!n)return alert("Digite o nome da atividade.");const a=getCustomActivities(),r=getRemovedActivities();if(!getAllActivities().includes(n))a.push(n);saveCustomActivities(a);saveRemovedActivities(r.filter(x=>x!==n));renderActivities();closeModal("activityModal")});

function renderCalendar(){
 const year=calendarDate.getFullYear(),month=calendarDate.getMonth(),names=["Janeiro","Fevereiro","Março","Abril","Maio","Junho","Julho","Agosto","Setembro","Outubro","Novembro","Dezembro"];
 $("calendarTitle").textContent=`${names[month]} ${year}`;const g=$("calendarGrid");g.innerHTML="";
 const first=new Date(year,month,1).getDay(),days=new Date(year,month+1,0).getDate(),prev=new Date(year,month,0).getDate(),entries=getEntries();
 for(let i=first-1;i>=0;i--)createDay(prev-i,true);
 for(let d=1;d<=days;d++)createDay(d,false);
 const rem=(first+days)%7===0?0:7-(first+days)%7;for(let i=1;i<=rem;i++)createDay(i,true);
 $("selectedDate").textContent=`Dia selecionado: ${formatDate(selectedDate)}`;
 function createDay(d,other){
  const b=document.createElement("button");b.type="button";b.className="day"+(other?" other-month":"");
  if(other){b.textContent=d;g.appendChild(b);return}
  const date=`${year}-${String(month+1).padStart(2,"0")}-${String(d).padStart(2,"0")}`,entry=entries.find(x=>x.date===date);
  b.innerHTML=`<span class="day-number">${d}</span>${entry?`<span class="day-mood" aria-label="Humor do dia: ${escapeHTML(entry.mood)}">${escapeHTML(entry.emoji)}</span>`:""}`;
  if(date===selectedDate)b.classList.add("selected");if(date===getToday())b.classList.add("today");
  b.setAttribute("aria-label",entry?`${formatDate(date)} — ${entry.mood}`:formatDate(date));
  b.addEventListener("click",()=>{selectedDate=date;loadDate(date);renderCalendar();updateStats()});g.appendChild(b);
 }
}
$("prevMonth").addEventListener("click",()=>{calendarDate.setMonth(calendarDate.getMonth()-1);renderCalendar();updateStats()});
$("nextMonth").addEventListener("click",()=>{calendarDate.setMonth(calendarDate.getMonth()+1);renderCalendar();updateStats()});

function selectMood(b){document.querySelectorAll(".mood").forEach(x=>x.classList.remove("selected"));b.classList.add("selected");selectedMood={name:b.dataset.mood,emoji:b.querySelector(".emoji").textContent}}
document.querySelectorAll(".mood").forEach(b=>b.addEventListener("click",()=>selectMood(b)));
function renderCustomMoods(){
 document.querySelectorAll(".custom-mood").forEach(x=>x.remove());
 getCustomMoods().forEach((m,i)=>{const w=document.createElement("div");w.className="mood custom-mood";w.dataset.mood=m.description;w.innerHTML=`<button class="mood-main" type="button" aria-label="Humor personalizado: ${escapeHTML(m.description)}"><span class="emoji">${escapeHTML(m.emoji)}</span><span class="mood-name">${escapeHTML(m.description)}</span></button><div class="custom-mood-tools"><button class="mood-tool edit" type="button" aria-label="Editar descrição do emoji" title="Editar">✎</button><button class="mood-tool remove" type="button" aria-label="Excluir emoji personalizado" title="Excluir">×</button></div>`;w.querySelector(".mood-main").addEventListener("click",()=>selectMood(w));w.querySelector(".edit").addEventListener("click",e=>{e.stopPropagation();openEditMood(i)});w.querySelector(".remove").addEventListener("click",e=>{e.stopPropagation();deleteCustomMood(i)});$("moods").appendChild(w)})
}
$("addMood").addEventListener("click",()=>{$("newMoodEmoji").value="";$("newMoodDescription").value="";$("moodModal").classList.add("active");setTimeout(()=>$("newMoodEmoji").focus(),50)});
$("confirmMood").addEventListener("click",()=>{const emoji=$("newMoodEmoji").value.trim(),description=$("newMoodDescription").value.trim();if(!emoji)return alert("Digite ou cole um emoji.");if(!description)return alert("Digite uma descrição para o emoji.");const m=getCustomMoods();m.push({emoji,description});saveCustomMoods(m);renderCustomMoods();closeModal("moodModal")});
function openEditMood(i){const m=getCustomMoods();if(!m[i])return;editingMoodIndex=i;$("editMoodDescription").value=m[i].description;$("editMoodModal").classList.add("active")}
$("confirmEditMood").addEventListener("click",()=>{if(editingMoodIndex===null)return;const d=$("editMoodDescription").value.trim();if(!d)return alert("Digite uma descrição.");const m=getCustomMoods();m[editingMoodIndex].description=d;saveCustomMoods(m);renderCustomMoods();editingMoodIndex=null;closeModal("editMoodModal")});
function deleteCustomMood(i){const m=getCustomMoods();if(!m[i]||!confirm("Excluir este emoji da sua lista?"))return;m.splice(i,1);saveCustomMoods(m);renderCustomMoods()}

const photoDrop=$("photoDrop"),photoInput=$("photo");
photoDrop.addEventListener("dragover",e=>{e.preventDefault();photoDrop.classList.add("dragging")});
photoDrop.addEventListener("dragleave",()=>photoDrop.classList.remove("dragging"));
photoDrop.addEventListener("drop",e=>{e.preventDefault();photoDrop.classList.remove("dragging");const f=e.dataTransfer.files[0];if(f)processImage(f)});
photoInput.addEventListener("change",e=>{const f=e.target.files[0];if(f)processImage(f)});
function processImage(file){
 if(!file.type.startsWith("image/"))return alert("Selecione uma imagem válida.");
 const r=new FileReader();r.onload=e=>{const img=new Image();img.onload=()=>{const max=1000;let w=img.width,h=img.height;if(w>max||h>max){if(w>h){h=Math.round(h*max/w);w=max}else{w=Math.round(w*max/h);h=max}}const c=document.createElement("canvas");c.width=w;c.height=h;c.getContext("2d").drawImage(img,0,0,w,h);photoData=c.toDataURL("image/jpeg",.72);$("preview").src=photoData;$("preview").style.display="block"};img.src=e.target.result};r.readAsDataURL(file)
}

function clearForm(){selectedMood=null;document.querySelectorAll(".mood").forEach(b=>b.classList.remove("selected"));document.querySelectorAll(".activity input").forEach(i=>i.checked=false);$("what").value="";$("freeWriting").value="";photoData="";$("photo").value="";$("preview").src="";$("preview").style.display="none"}
function loadDate(date){
 clearForm();const e=getEntries().find(x=>x.date===date);if(!e)return;
 let b=[...document.querySelectorAll(".mood")].find(x=>x.dataset.mood===e.mood&&x.querySelector(".emoji").textContent===e.emoji);
 if(!b){b=document.createElement("button");b.className="mood";b.dataset.mood=e.mood;b.type="button";b.innerHTML=`<span class="emoji">${escapeHTML(e.emoji)}</span><span class="mood-name">${escapeHTML(e.mood)}</span>`;b.addEventListener("click",()=>selectMood(b));$("moods").appendChild(b)}selectMood(b);
 (e.activities||[]).forEach(a=>{let i=[...document.querySelectorAll(".activity input")].find(x=>x.value===a);if(!i){const l=document.createElement("label");l.className="activity";l.innerHTML=`<input type="checkbox" value="${escapeHTML(a)}"><span class="activity-name">${escapeHTML(a)}</span><button type="button" class="activity-delete" aria-label="Excluir atividade">×</button>`;l.querySelector(".activity-delete").addEventListener("click",ev=>{ev.preventDefault();ev.stopPropagation();deleteActivity(a)});$("activities").appendChild(l);i=l.querySelector("input")}i.checked=true});
 $("what").value=e.what||"";$("freeWriting").value=e.freeWriting||"";photoData=e.photo||"";if(photoData){$("preview").src=photoData;$("preview").style.display="block"}
}
$("save").addEventListener("click",()=>{if(!selectedMood)return alert("Escolha como você está se sentindo.");const activities=[...document.querySelectorAll(".activity input:checked")].map(i=>i.value),e={id:Date.now(),date:selectedDate,mood:selectedMood.name,emoji:selectedMood.emoji,activities,what:$("what").value.trim(),freeWriting:$("freeWriting").value,photo:photoData},entries=getEntries(),idx=entries.findIndex(x=>x.date===selectedDate);if(idx!==-1){e.id=entries[idx].id;entries[idx]=e}else entries.unshift(e);saveEntries(entries);renderCalendar();updateStats();renderHistory();alert("Entrada salva no SpaceTime.")});

function updateStats(){
  const year=calendarDate.getFullYear(),month=calendarDate.getMonth();
  const names=["Janeiro","Fevereiro","Março","Abril","Maio","Junho","Julho","Agosto","Setembro","Outubro","Novembro","Dezembro"];
  const monthName=names[month];
  $("statsMonth").textContent=`${monthName} ${year}`;
  $("chartMonthLabel").textContent=`${monthName} ${year}`;

  const allEntries=getEntries();
  const entries=allEntries.filter(e=>{
    const [y,m]=e.date.split("-").map(Number);
    return y===year&&m===month+1
  });

  renderStreak(allEntries);
  renderMoodChart(entries, $("activityFilter").value);
  renderAchievements(allEntries);

  const filter=$("activityFilter");
  const current=filter.value;
  filter.innerHTML='<option value="">Todas as atividades</option>';
  [...new Set(allEntries.flatMap(e=>e.activities||[]))].sort((a,b)=>a.localeCompare(b,"pt-BR")).forEach(a=>{
    const o=document.createElement("option");o.value=a;o.textContent=a;filter.appendChild(o)
  });
  if([...filter.options].some(o=>o.value===current))filter.value=current;

  const c=$("statsContainer");
  c.innerHTML="";
  const moods=[...MOODS,...getCustomMoods().map(m=>({name:m.description,emoji:m.emoji}))],unique=[];
  moods.forEach(m=>{if(!unique.some(x=>x.name===m.name))unique.push(m)});
  if(!entries.length){
    c.innerHTML='<div class="empty">Nenhum registro neste mês.</div>';
    $("statsSummary").textContent="Registre um dia para começar a acompanhar seus sentimentos.";
    return
  }
  unique.forEach(m=>{
    const count=entries.filter(e=>e.mood===m.name).length;
    if(!count)return;
    const p=Math.round(count/entries.length*100),row=document.createElement("div");
    row.className="stat-row";
    row.innerHTML=`<div class="stat-top"><span class="stat-label"><span>${escapeHTML(m.emoji)}</span><span>${escapeHTML(m.name)}</span></span><strong>${count} · ${p}%</strong></div><div class="stat-bar"><div class="stat-fill" style="width:${p}%"></div></div>`;
    c.appendChild(row)
  });
  $("statsSummary").textContent=`${entries.length} ${entries.length===1?"dia registrado":"dias registrados"} neste mês.`;
}

function getDateKey(date){return `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,"0")}-${String(date.getDate()).padStart(2,"0")}`}
function addDays(date,n){const d=new Date(date);d.setDate(d.getDate()+n);return d}

function renderStreak(allEntries){
  const set=new Set(allEntries.map(e=>e.date));
  const today=new Date();
  const box=$("streakDays");box.innerHTML="";
  for(let i=4;i>=0;i--){
    const d=addDays(today,-i),key=getDateKey(d),done=set.has(key);
    const item=document.createElement("div");item.className="streak-day";
    item.innerHTML=`<div class="streak-circle ${done?"done ":""}${i===0?"today":""}">${done?"✓":d.getDate()}</div><div class="streak-label">${i===0?"Hoje":d.toLocaleDateString("pt-BR",{weekday:"short"}).replace(".","")}</div>`;
    box.appendChild(item)
  }
  let current=0,d=new Date(today);
  while(set.has(getDateKey(d))){current++;d.setDate(d.getDate()-1)}
  let best=0,run=0;
  const sorted=[...set].sort();
  for(let i=0;i<sorted.length;i++){
    run=i>0 && Math.round((new Date(sorted[i]+"T00:00:00")-new Date(sorted[i-1]+"T00:00:00"))/86400000)===1?run+1:1;
    best=Math.max(best,run)
  }
  $("streakBest").innerHTML=`🏆 Sequência atual: <strong>${current}</strong> dia${current===1?"":"s"} · Melhor sequência: <strong>${best}</strong>`;
}

function renderMoodChart(entries,activity){
  const svg=$("moodChart");svg.innerHTML="";
  const W=640,H=220,left=42,right=14,top=14,bottom=28;
  const innerW=W-left-right,innerH=H-top-bottom;
  const values=[];
  for(let day=1;day<=new Date(calendarDate.getFullYear(),calendarDate.getMonth()+1,0).getDate();day++){
    const date=`${calendarDate.getFullYear()}-${String(calendarDate.getMonth()+1).padStart(2,"0")}-${String(day).padStart(2,"0")}`;
    const e=entries.find(x=>x.date===date);
    const moodIndex={"Muito triste":1,"Triste":2,"Neutro":3,"Feliz":4,"Muito feliz":5};
    if(e && (!activity || (e.activities||[]).includes(activity)) && moodIndex[e.mood])values.push({day,v:moodIndex[e.mood]});
  }
  for(let v=1;v<=5;v++){
    const y=top+innerH-(v-1)*innerH/4;
    const line=document.createElementNS("http://www.w3.org/2000/svg","line");
    line.setAttribute("x1",left);line.setAttribute("x2",W-right);line.setAttribute("y1",y);line.setAttribute("y2",y);line.setAttribute("class","chart-grid");svg.appendChild(line);
    const t=document.createElementNS("http://www.w3.org/2000/svg","text");
    t.setAttribute("x",8);t.setAttribute("y",y+4);t.setAttribute("class","chart-label");t.textContent=["","😢","🙁","😐","🙂","😄"][v];svg.appendChild(t)
  }
  if(!values.length){
    const t=document.createElementNS("http://www.w3.org/2000/svg","text");
    t.setAttribute("x",W/2);t.setAttribute("y",H/2);t.setAttribute("text-anchor","middle");t.setAttribute("class","chart-empty");
    t.textContent="Registre seu humor para ver o gráfico.";svg.appendChild(t);return
  }
  const daysInMonth=new Date(calendarDate.getFullYear(),calendarDate.getMonth()+1,0).getDate();
  const pts=values.map(o=>[left+(o.day-1)/(Math.max(1,daysInMonth-1))*innerW,top+innerH-(o.v-1)*innerH/4]);
  let d=`M ${pts[0][0]} ${pts[0][1]}`;
  for(let i=1;i<pts.length;i++){const [x0,y0]=pts[i-1],[x,y]=pts[i],mx=(x0+x)/2;d+=` C ${mx} ${y0}, ${mx} ${y}, ${x} ${y}`}
  const area=d+` L ${pts[pts.length-1][0]} ${top+innerH} L ${pts[0][0]} ${top+innerH} Z`;
  const areaPath=document.createElementNS("http://www.w3.org/2000/svg","path");areaPath.setAttribute("d",area);areaPath.setAttribute("class","chart-area");svg.appendChild(areaPath);
  const path=document.createElementNS("http://www.w3.org/2000/svg","path");path.setAttribute("d",d);path.setAttribute("class","chart-line");svg.appendChild(path);
  pts.forEach((p,i)=>{
    const c=document.createElementNS("http://www.w3.org/2000/svg","circle");c.setAttribute("cx",p[0]);c.setAttribute("cy",p[1]);c.setAttribute("r",5);c.setAttribute("class","chart-point");c.setAttribute("aria-label",`Dia ${values[i].day}`);svg.appendChild(c)
  });
  [1,7,14,21,28].forEach(day=>{
    if(day>daysInMonth)return;
    const t=document.createElementNS("http://www.w3.org/2000/svg","text");
    t.setAttribute("x",left+(day-1)/(Math.max(1,daysInMonth-1))*innerW);t.setAttribute("y",H-6);t.setAttribute("text-anchor","middle");t.setAttribute("class","chart-label");t.textContent=day;svg.appendChild(t)
  })
}

function renderAchievements(allEntries){
  const dates=new Set(allEntries.map(e=>e.date));
  let best=0,run=0,prev=null;
  [...dates].sort().forEach(v=>{
    const d=new Date(v+"T00:00:00");
    if(prev && Math.round((d-prev)/86400000)===1)run++;else run=1;
    best=Math.max(best,run);prev=d
  });
  const achievements=[
    {icon:"🌱",name:"Primeira viagem",desc:"Registrar 1 dia",ok:allEntries.length>=1},
    {icon:"🔥",name:"Astronauta",desc:"7 dias seguidos",ok:best>=7},
    {icon:"📖",name:"10 registros",desc:"Guardar 10 dias",ok:allEntries.length>=10},
    {icon:"🌟",name:"Um mês",desc:"30 registros",ok:allEntries.length>=30},
    {icon:"💫",name:"Sequência",desc:"14 dias seguidos",ok:best>=14},
    {icon:"🏆",name:"Constância",desc:"60 registros",ok:allEntries.length>=60}
  ];
  $("achievementList").innerHTML=achievements.map(a=>`<div class="achievement ${a.ok?"":"locked"}"><span class="achievement-icon">${a.icon}</span><div class="achievement-name">${a.name}</div><div class="achievement-desc">${a.desc}</div></div>`).join("")
}

$("activityFilter").addEventListener("change",()=>updateStats());
$("historyToggle").addEventListener("click",()=>{const p=$("historyPanel"),open=p.classList.toggle("open");$("historyToggle").setAttribute("aria-expanded",open)});
function renderHistory(){
 const entries=getEntries(),c=$("entries");if(!entries.length){c.innerHTML='<div class="empty">Nenhum dia registrado ainda.</div>';return}
 const t=document.createElement("div");t.className="timeline";entries.forEach(e=>{const card=document.createElement("article");card.className="history-card";const acts=e.activities||[],preview=e.what||e.freeWriting||"Sem texto registrado.";card.innerHTML=`<div class="history-date">${formatDate(e.date)}</div><div class="history-mood"><span class="history-mood-emoji" aria-hidden="true">${escapeHTML(e.emoji)}</span><span class="history-mood-name">${escapeHTML(e.mood)}</span></div>${acts.length?`<div class="tags">${acts.map(a=>`<span class="tag">${escapeHTML(a)}</span>`).join("")}</div>`:""}${e.photo?`<img class="history-image" src="${e.photo}" alt="Foto registrada em ${formatDate(e.date)}">`:""}<div class="history-preview">${escapeHTML(preview)}</div><div class="history-actions"><button class="danger-button" type="button" aria-label="Excluir registro de ${formatDate(e.date)}">Excluir</button></div>`;card.querySelector(".danger-button").addEventListener("click",()=>removeEntry(e.id));card.addEventListener("dblclick",()=>{selectedDate=e.date;const[y,m]=e.date.split("-").map(Number);calendarDate=new Date(y,m-1,1);loadDate(selectedDate);renderCalendar();updateStats();scrollTo({top:0,behavior:"smooth"})});t.appendChild(card)});c.innerHTML="";c.appendChild(t)
}
function removeEntry(id){if(!confirm("Excluir este registro?"))return;saveEntries(getEntries().filter(e=>e.id!==id));renderCalendar();updateStats();renderHistory();if(!getEntries().some(e=>e.date===selectedDate))clearForm()}
function closeModal(id){$(id).classList.remove("active")}
document.querySelectorAll(".modal-overlay").forEach(m=>m.addEventListener("click",e=>{if(e.target===m)m.classList.remove("active")}));
$("newActivity").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();$("confirmActivity").click()}});
$("newMoodDescription").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();$("confirmMood").click()}});
$("editMoodDescription").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();$("confirmEditMood").click()}});
loadTheme();loadUserEmail();renderActivities();renderCustomMoods();renderCalendar();loadDate(selectedDate);updateStats();renderHistory();
</script>
</body>
</html>
