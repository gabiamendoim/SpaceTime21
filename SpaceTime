*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-height:100vh;background:radial-gradient(circle at 10% 12%,rgba(80,139,205,.28) 0 1px,transparent 2px),radial-gradient(circle at 24% 42%,rgba(128,178,231,.24) 0 1.5px,transparent 2.5px),radial-gradient(circle at 78% 16%,rgba(94,153,220,.25) 0 1px,transparent 2px),radial-gradient(circle at 91% 68%,rgba(137,190,238,.25) 0 1.5px,transparent 2.5px),radial-gradient(circle at 52% 86%,rgba(83,145,211,.2) 0 1px,transparent 2px),radial-gradient(ellipse at 50% 30%,rgba(128,180,230,.16),transparent 45%),linear-gradient(180deg,#dceeff 0%,#f3f9ff 44%,#dcecf9 100%);background-size:170px 150px,230px 190px,280px 210px,310px 240px,190px 170px,100% 100%,100% 100%;color:var(--text);font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;transition:.3s}button,input,textarea{font:inherit}button{-webkit-tap-highlight-color:transparent}.app{width:min(820px,100%);margin:auto;padding:24px 16px 55px}
header{position:relative;text-align:center;margin-bottom:22px}.logo{margin:0;font-size:38px;line-height:1;letter-spacing:-1.8px;font-weight:850;text-shadow:0 0 8px rgba(125,185,235,.22),0 4px 22px rgba(65,120,180,.2)}.logo span{color:var(--primary-dark)}.logo-subtitle{margin:8px 0 0;color:var(--text-soft);font-size:14px}
.theme-toggle{position:absolute;top:0;right:0;width:48px;height:28px;border:1px solid var(--border);border-radius:999px;background:var(--card);cursor:pointer;padding:3px}.theme-toggle::after{content:"";display:block;width:20px;height:20px;border-radius:50%;background:var(--primary);transition:.25s}.space-theme .theme-toggle::after{transform:translateX(20px)}
.card{background:linear-gradient(145deg,rgba(255,255,255,.9),rgba(237,247,255,.88));border:1px solid rgba(143,191,227,.82);border-radius:24px;padding:20px;margin:15px 0;box-shadow:0 16px 42px rgba(45,93,140,.16),inset 0 1px 0 rgba(255,255,255,.95);backdrop-filter:blur(8px)}h2{margin:0;font-size:18px}.section-title-row,.calendar-header,.entry-header{display:flex;align-items:center;justify-content:space-between;gap:12px}
.icon-button,.add-button,.nav-button{border:0;background:var(--primary-light);color:var(--primary-dark);cursor:pointer;transition:.15s}.icon-button:hover,.add-button:hover,.nav-button:hover{transform:translateY(-1px);background:var(--accent)}.add-button{width:35px;height:35px;border-radius:11px;font-size:22px}.nav-button{width:35px;height:35px;border-radius:10px;font-size:20px}.danger-button{border:0;background:var(--danger-bg);color:var(--danger);border-radius:9px;padding:6px 9px;cursor:pointer}
.calendar-title{font-weight:800}.calendar-nav{display:flex;gap:6px}.weekdays,.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}.weekdays{margin-top:13px}.weekdays div{text-align:center;font-size:10px;color:var(--text-soft);font-weight:800;padding:7px 0}.day{min-height:55px;border:1px solid transparent;border-radius:14px;background:var(--calendar);color:var(--text);cursor:pointer;position:relative;transition:.2s}.day:hover{border-color:var(--primary);transform:translateY(-1px)}.day.other-month{opacity:.3}.day.today{border-color:var(--primary)}.day.selected{background:var(--primary);color:#fff}.day-number{position:absolute;top:7px;left:8px;font-size:11px;font-weight:700}.day-mood{display:block;margin-top:17px;font-size:22px}.selected-date{text-align:center;margin-top:13px;color:var(--text-soft);font-size:13px}
.moods{display:grid;grid-template-columns:repeat(5,1fr);gap:9px}.mood{border:2px solid transparent;background:var(--card-soft);color:var(--text);border-radius:18px;padding:11px 5px;cursor:pointer;text-align:center;min-width:0;transition:.2s}.mood:hover{transform:translateY(-2px)}.mood.selected{border-color:var(--primary);background:var(--primary-light)}.emoji{display:block;font-size:34px}.mood-name{display:block;margin-top:4px;color:var(--text-soft);font-size:10px;font-weight:750;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.custom-mood-tools{display:flex;justify-content:center;gap:2px;margin-top:5px}.mood-tool{border:0;background:transparent;color:var(--text-soft);cursor:pointer;padding:2px 5px}.mood-main{border:0;background:transparent;color:inherit;cursor:pointer}
.activities{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.activity{display:flex;align-items:center;gap:8px;background:var(--card-soft);border:1px solid transparent;border-radius:14px;padding:10px;color:var(--text);transition:.2s}.activity:hover{border-color:var(--border)}.activity input{width:18px;height:18px;accent-color:var(--primary-dark)}.activity-name{flex:1}.activity-delete{border:0;background:transparent;color:var(--text-soft);cursor:pointer;font-size:16px}.activity-delete:hover{color:var(--danger)}
.field{display:grid;gap:7px;font-size:14px;font-weight:750}textarea,input[type=text]{width:100%;border:1px solid var(--border);border-radius:14px;padding:12px;background:var(--input);color:var(--text);outline:none;transition:.2s}textarea:focus,input[type=text]:focus{border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-light)}.free-writing{min-height:220px;line-height:1.6}
.photo-drop{border:2px dashed var(--border);border-radius:20px;padding:25px 15px;text-align:center;background:var(--card-soft);cursor:pointer;transition:.2s;display:block}.photo-drop.dragging,.photo-drop:hover{border-color:var(--primary);background:var(--primary-light)}.photo-drop strong{display:block;margin-bottom:5px}.photo-drop span{color:var(--text-soft);font-size:13px}#photo{display:none}#preview{display:none;max-width:100%;max-height:270px;object-fit:cover;border-radius:16px;margin:15px auto 0}
.save{width:100%;border:0;border-radius:16px;padding:15px;background:var(--primary);color:#fff;font-weight:800;cursor:pointer;transition:.2s}.save:hover{background:var(--primary-dark);transform:translateY(-1px)}
.stats-header{margin-bottom:18px}.stats-month{color:var(--text-soft);font-size:13px}.stat-row{margin:14px 0}.stat-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:6px;font-size:13px}.stat-label{display:flex;align-items:center;gap:7px}.stat-bar{height:9px;background:var(--primary-light);border-radius:999px;overflow:hidden}.stat-fill{height:100%;width:0;background:var(--progress);border-radius:999px;transition:width .5s}.stat-summary{margin-top:17px;padding-top:14px;border-top:1px solid var(--border);color:var(--text-soft);font-size:13px}
.history-panel{display:none}.history-panel.open{display:block}.timeline{position:relative;margin-top:20px;padding-left:22px}.timeline::before{content:"";position:absolute;left:6px;top:4px;bottom:4px;width:2px;background:var(--border)}.history-card{position:relative;background:var(--card-soft);border:1px solid var(--border);border-radius:18px;padding:16px;margin-bottom:14px}.history-card::before{content:"";position:absolute;left:-21px;top:20px;width:10px;height:10px;border-radius:50%;background:var(--primary);border:3px solid var(--card)}.history-date{color:var(--text-soft);font-size:12px;font-weight:800}.history-mood{display:flex;align-items:center;gap:10px;margin-top:7px}.history-mood-emoji{font-size:30px}.history-mood-name{font-weight:800}.tags{display:flex;flex-wrap:wrap;gap:6px;margin:12px 0}.tag{background:var(--primary-light);color:var(--primary-dark);border-radius:999px;padding:5px 9px;font-size:11px;font-weight:700}.history-preview{color:var(--text-soft);font-size:13px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.history-image{width:100%;max-height:190px;object-fit:cover;border-radius:14px;margin-top:10px}.history-actions{display:flex;justify-content:flex-end;margin-top:12px}.modal-overlay{position:fixed;inset:0;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(10,25,40,.45);z-index:100}.modal-overlay.active{display:flex}.modal{width:min(420px,100%);background:var(--card);border:1px solid var(--border);border-radius:22px;padding:22px;box-shadow:0 20px 60px rgba(0,0,0,.2)}.modal h3{margin:0 0 7px}.modal p{margin-top:0;color:var(--text-soft);font-size:13px}.modal-actions{display:flex;gap:8px;margin-top:15px}.modal-actions button{flex:1;border:0;border-radius:12px;padding:12px;cursor:pointer;font-weight:750}.cancel{background:var(--card-soft);color:var(--text)}.confirm{background:var(--primary);color:#fff}.empty{color:var(--text-soft);font-size:13px;padding:10px 0}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
@media(max-width:600px){.app{padding:18px 11px 40px}.card{padding:16px;border-radius:20px}.theme-toggle{position:relative;display:block;margin:12px auto 0}.moods{gap:5px}.emoji{font-size:27px}.mood{padding:9px 2px}.mood-name{font-size:8px}.activities{grid-template-columns:1fr}.day{min-height:49px}.day-mood{font-size:19px}.weekdays div{font-size:9px}.logo{font-size:34px}}
@media(max-width:360px){.day{min-height:44px}.day-mood{font-size:17px}.day-number{font-size:9px}}

.color-button{width:24px;height:24px;border:2px solid var(--card);outline:1px solid transparent;border-radius:50%;cursor:pointer;padding:0;transition:transform .18s,outline-color .18s}
.color-button:hover{transform:scale(1.1)}
.color-button.active{outline:2px solid var(--primary-dark);outline-offset:2px}
.color-blue{background:#8eb9d8}.color-wine{background:#8f3f50}.color-green{background:#5d9b70}
@media(max-width:600px){.calendar-title-wrap{gap:8px}.color-picker{gap:5px}.color-button{width:20px;height:20px}.theme-toggle{position:relative;display:block;margin:0 auto}}
.calendar-title-wrap{display:flex;align-items:center;gap:10px;min-width:0}.color-picker{display:flex;align-items:center;gap:5px;background:var(--card-soft);border:1px solid var(--border);border-radius:999px;padding:4px 6px}.color-button{width:20px;height:20px;border:2px solid var(--card);outline:1px solid transparent;border-radius:50%;cursor:pointer;padding:0;transition:transform .18s,outline-color .18s}.color-button:hover{transform:scale(1.08)}.color-button.active{outline:2px solid var(--primary-dark);outline-offset:1px}.color-blue{background:#8eb9d8}.color-wine{background:#8f3f50}.color-green{background:#5d9b70}
/* Painel de estatísticas inspirado em apps de diário */
.stats-dashboard{display:grid;gap:14px}
.stats-card{background:var(--card-soft);border:1px solid var(--border);border-radius:20px;padding:17px}
.stats-card h3{margin:0;font-size:19px}
.stats-card-sub{margin:5px 0 0;color:var(--text-soft);font-size:13px}
.streak-days{display:flex;gap:8px;overflow:auto;padding:15px 0 4px}
.streak-day{min-width:57px;text-align:center}
.streak-circle{width:45px;height:45px;margin:0 auto 6px;border:2px solid var(--border);border-radius:50%;display:grid;place-items:center;font-weight:800;color:var(--text-soft);background:var(--card)}
.streak-circle.done{background:var(--primary);border-color:var(--primary);color:#fff}
.streak-circle.today{border-color:var(--primary-dark);box-shadow:0 0 0 3px var(--primary-light)}
.streak-label{font-size:10px;color:var(--text-soft);font-weight:750}
.streak-best{margin-top:13px;padding-top:13px;border-top:1px solid var(--border);color:var(--text-soft);font-size:13px}
.streak-best strong{color:var(--text)}
.mood-chart-wrap{margin-top:15px;overflow:hidden;border-radius:14px}
.mood-chart{width:100%;height:220px;display:block}
.chart-grid{stroke:var(--border);stroke-width:1}
.chart-label{fill:var(--text-soft);font-size:11px}
.chart-line{fill:none;stroke:var(--primary);stroke-width:4;stroke-linecap:round;stroke-linejoin:round}
.chart-area{fill:var(--primary-light);opacity:.65}
.chart-point{fill:var(--primary);stroke:var(--card-soft);stroke-width:3}
.chart-empty{fill:var(--text-soft);font-size:13px}
.stats-controls{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:13px}
.activity-filter{border:1px solid var(--border);border-radius:999px;background:var(--card);color:var(--text);padding:9px 13px;outline:none;min-width:150px}
.achievement-list{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:14px}
.achievement{border:1px solid var(--border);border-radius:16px;padding:12px;text-align:center;background:var(--card)}
.achievement.locked{opacity:.5}
.achievement-icon{font-size:25px;display:block;margin-bottom:5px}
.achievement-name{font-size:11px;font-weight:800}
.achievement-desc{font-size:10px;color:var(--text-soft);margin-top:3px}
.stats-summary-new{margin-top:12px;color:var(--text-soft);font-size:13px}
@media(max-width:600px){
  .achievement-list{grid-template-columns:repeat(3,1fr)}
  .stats-card{padding:15px}
  .stats-card h3{font-size:18px}
  .mood-chart{height:190px}
}

/* Cores tipográficas adaptadas ao tema */
body.theme-wine{--text:#5a2937;--text-soft:#825d68}
body.theme-green{--text:#284b35;--text-soft:#5e7867}
body.space-theme{--text:#dcecff;--text-soft:#9db2d0}
body.space-theme.theme-wine{--text:#f6dfe6;--text-soft:#cba9b5}
body.space-theme.theme-green{--text:#ddf2e3;--text-soft:#a8c4af}
body.space-theme .logo{color:#e8f3ff;text-shadow:0 0 10px rgba(145,190,255,.35),0 0 28px rgba(80,130,220,.28)}
body.space-theme .logo span{color:var(--primary-dark)}
body.space-theme .logo-subtitle{color:var(--text-soft)}
body.space-theme .card{background:linear-gradient(145deg,rgba(16,31,52,.94),rgba(10,24,43,.92));border-color:rgba(91,124,172,.55);box-shadow:0 18px 45px rgba(0,0,0,.34),inset 0 1px 0 rgba(180,210,255,.06)}
body.space-theme .calendar-title,
body.space-theme h2,
body.space-theme h3,
body.space-theme .field,
body.space-theme .achievement-name,
body.space-theme .history-mood-name{color:var(--text)}
body.space-theme .selected-date,
body.space-theme .stats-month,
body.space-theme .stats-card-sub,
body.space-theme .stats-summary-new,
body.space-theme .stats-summary,
body.space-theme .history-date,
body.space-theme .history-preview,
body.space-theme .streak-label,
body.space-theme .streak-best,
body.space-theme .mood-name{color:var(--text-soft)}
body.theme-wine .logo span{color:var(--primary-dark)}
body.theme-green .logo span{color:var(--primary-dark)}

</style>
</head>
<body>
<div class="app">
<header>
<button id="themeToggle" class="theme-toggle" type="button" aria-label="Alternar entre modo dia e modo espacial" title="Alternar tema"></button>
<h1 class="logo">Space<span>time</span></h1>
<p class="logo-subtitle">✦ Um cantinho só seu para guardar o dia ✦</p><div aria-hidden="true" style="margin-top:10px;color:var(--primary-dark);letter-spacing:8px;font-size:10px;opacity:.8">·  ·  ✦  ·  ·</div>
</header>


<section class="card" id="emailCard">
  <label class="field" for="userEmail">
    <span>Seu e-mail</span>
    <input id="userEmail" type="email" autocomplete="email" placeholder="seuemail@exemplo.com" aria-label="Seu e-mail">
  </label>
  <p id="emailStatus" class="selected-date" style="margin-bottom:0">Seu e-mail fica salvo neste navegador para identificar seus dados.</p>
</section>

<section class="card">
<div class="calendar-header">
<div class="calendar-title-wrap">
<strong id="calendarTitle" class="calendar-title"></strong>
<div class="color-picker" aria-label="Escolher cor do SpaceTime" title="Escolher cor">
<button class="color-button color-blue" data-color="blue" type="button" aria-label="Tema azul" title="Azul"></button>
<button class="color-button color-wine" data-color="wine" type="button" aria-label="Tema vinho" title="Vinho"></button>
<button class="color-button color-green" data-color="green" type="button" aria-label="Tema verde" title="Verde"></button>
</div>
</div>
<div class="calendar-nav"><button id="prevMonth" class="nav-button" type="button" aria-label="Mês anterior">‹</button><button id="nextMonth" class="nav-button" type="button" aria-label="Próximo mês">›</button></div>
</div>
<div class="weekdays"><div>DOM</div><div>SEG</div><div>TER</div><div>QUA</div><div>QUI</div><div>SEX</div><div>SÁB</div></div>
<div id="calendarGrid" class="calendar-grid"></div>
<div id="selectedDate" class="selected-date"></div>
</section>

<section class="card">
<div class="stats-header"><h2>Estatísticas</h2><span id="statsMonth" class="stats-month"></span></div>
<div class="stats-dashboard">

<div class="stats-card">
  <h3>Dias seguidos</h3>
  <p class="stats-card-sub">Continue registrando seus dias para acompanhar sua sequência.</p>
  <div id="streakDays" class="streak-days"></div>
  <div id="streakBest" class="streak-best"></div>
</div>

<div class="stats-card">
  <h3>Gráfico de humor</h3>
  <p class="stats-card-sub">Veja como seu humor variou ao longo do mês.</p>
  <div class="mood-chart-wrap">
    <svg id="moodChart" class="mood-chart" viewBox="0 0 640 220" role="img" aria-label="Gráfico de humor do mês"></svg>
  </div>
  <div class="stats-controls">
    <span id="chartMonthLabel" class="stats-month"></span>
    <select id="activityFilter" class="activity-filter" aria-label="Filtrar gráfico por atividade">
      <option value="">Todas as atividades</option>
    </select>
  </div>
</div>

<div class="stats-card">
  <h3>Conquistas</h3>
  <p class="stats-card-sub">Pequenas marcas para acompanhar sua jornada no diário.</p>
  <div id="achievementList" class="achievement-list"></div>
</div>

<div class="stats-card">
  <div id="statsContainer"></div>
  <div id="statsSummary" class="stats-summary-new"></div>
</div>

</div>
</section>

<section class="card">
<div class="section-title-row"><h2>Como você está se sentindo?</h2><button id="addMood" class="add-button" type="button" aria-label="Adicionar novo emoji de humor" title="Adicionar humor">+</button></div>
<div id="moods" class="moods">
<button class="mood" data-mood="Muito feliz" type="button" aria-label="Humor: muito feliz"><span class="emoji">😄</span><span class="mood-name">Muito feliz</span></button>
<button class="mood" data-mood="Feliz" type="button" aria-label="Humor: feliz"><span class="emoji">🙂</span><span class="mood-name">Feliz</span></button>
<button class="mood" data-mood="Neutro" type="button" aria-label="Humor: neutro"><span class="emoji">😐</span><span class="mood-name">Neutro</span></button>
