body.theme-green{--bg:#f2f8f3;--bg-soft:#f9fcf9;--card:#fff;--card-soft:#edf7ef;--text:#304d39;--text-soft:#657b6b;--primary:#5d9b70;--primary-dark:#3f7b54;--primary-light:#dceee1;--accent:#a8cdb2;--border:#d3e5d7;--danger:#b85d68;--danger-bg:#fff0f2;--shadow:0 12px 35px rgba(60,110,75,.1);--input:#fff;--calendar:#f4faf5;--progress:#5d9b70}
body.space-theme.theme-wine{--bg:#211017;--bg-soft:#2b141d;--card:#351b26;--card-soft:#40212d;--text:#f6e7eb;--text-soft:#c8aeb7;--primary:#b76579;--primary-dark:#d58b9c;--primary-light:#512b38;--accent:#7d4657;--border:#5b3342;--danger:#e19aa7;--danger-bg:#4b2530;--shadow:0 15px 40px rgba(0,0,0,.3);--input:#2d1720;--calendar:#2d1721;--progress:#b76579}
